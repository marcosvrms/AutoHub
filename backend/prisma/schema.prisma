// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  INDIVIDUAL
  DEALERSHIP
}

enum UserRole {
  USER
  ADMIN
}

enum AttributeType {
  BOOLEAN
  INTEGER
  DECIMAL
  TEXT
  SELECT
  MULTI_SELECT
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  SOLD
  INACTIVE
}

enum WalletTransactionType {
  DEPOSIT
  PURCHASE
  SALE
}

model User {
  id   String @id @default(uuid())
  name String

  email        String @unique
  passwordHash String

  accountType AccountType @default(INDIVIDUAL)
  role        UserRole    @default(USER)

  document String @unique
  phone    String

  birthDate      DateTime?
  foundationDate DateTime?

  photo       String?
  description String?

  city    String
  state   String
  country String @default("Brasil")

  address           String?
  cep               String?
  stateRegistration String?

  balance Decimal @default(0) @db.Decimal(15, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings Listing[]

  purchasesAsBuyer   Purchase[]          @relation("PurchaseBuyer")
  purchasesAsSeller  Purchase[]          @relation("PurchaseSeller")
  walletTransactions WalletTransaction[]
}

model Category {
  id   String @id @default(uuid())
  name String @unique

  vehicleTypes VehicleType[]
}

model VehicleType {
  id         String @id @default(uuid())
  categoryId String
  name       String

  category      Category       @relation(fields: [categoryId], references: [id])
  vehicleModels VehicleModel[]

  @@unique([categoryId, name])
}

model Manufacturer {
  id   String @id @default(uuid())
  name String @unique

  vehicleModels VehicleModel[]
}

model VehicleModel {
  id              String  @id @default(uuid())
  vehicleTypeId   String
  manufacturerId  String
  name            String
  manufactureYear Int
  description     String?
  catalogImage    String?

  listings     Listing[]
  vehicleType  VehicleType      @relation(fields: [vehicleTypeId], references: [id])
  manufacturer Manufacturer     @relation(fields: [manufacturerId], references: [id])
  attributes   ModelAttribute[]

  @@unique([vehicleTypeId, manufacturerId, name, manufactureYear])
}

model ModelAttribute {
  id             String        @id @default(uuid())
  vehicleModelId String
  name           String
  type           AttributeType
  required       Boolean       @default(true)
  displayOrder   Int           @default(0)

  listingValues ListingAttributeValue[]
  vehicleModel  VehicleModel            @relation(fields: [vehicleModelId], references: [id], onDelete: Cascade)
  options       ModelAttributeOption[]

  @@unique([vehicleModelId, name])
}

model ModelAttributeOption {
  id           String @id @default(uuid())
  attributeId  String
  value        String
  displayOrder Int    @default(0)

  listingOptionValues ListingAttributeValueOption[]

  attribute ModelAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([attributeId, value])
}

model Listing {
  id             String  @id @default(uuid())
  sellerId       String?
  vehicleModelId String

  title            String
  description      String?
  price            Decimal @db.Decimal(15, 2)
  acceptsProposals Boolean @default(false)

  status ListingStatus @default(DRAFT)

  country String @default("Brasil")
  state   String
  city    String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  soldAt    DateTime?

  seller       User?        @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  vehicleModel VehicleModel @relation(fields: [vehicleModelId], references: [id], onDelete: Restrict)

  purchase Purchase?

  attributeValues ListingAttributeValue[]
  images          ListingImage[]

  @@index([sellerId])
  @@index([vehicleModelId])
  @@index([status])
  @@index([price])
  @@index([city, state])
}

model ListingAttributeValue {
  id               String @id @default(uuid())
  listingId        String
  modelAttributeId String

  textValue    String?
  integerValue Int?
  decimalValue Decimal? @db.Decimal(18, 4)
  booleanValue Boolean?

  listing        Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  modelAttribute ModelAttribute @relation(fields: [modelAttributeId], references: [id], onDelete: Cascade)

  selectedOptions ListingAttributeValueOption[]

  @@unique([listingId, modelAttributeId])
}

model ListingAttributeValueOption {
  listingAttributeValueId String
  modelAttributeOptionId  String

  listingAttributeValue ListingAttributeValue @relation(fields: [listingAttributeValueId], references: [id], onDelete: Cascade)
  modelAttributeOption  ModelAttributeOption  @relation(fields: [modelAttributeOptionId], references: [id], onDelete: Cascade)

  @@id([listingAttributeValueId, modelAttributeOptionId])
}

model ListingImage {
  id           String   @id @default(uuid())
  listingId    String
  url          String
  displayOrder Int
  createdAt    DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, displayOrder])
}

model WalletTransaction {
  id String @id @default(uuid())

  userId String
  type   WalletTransactionType

  amount      Decimal @db.Decimal(15, 2)
  description String?

  purchaseId String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([purchaseId])
  @@index([createdAt])
}

model Purchase {
  id String @id @default(uuid())

  listingId String @unique

  buyerId  String
  sellerId String?

  amount Decimal @db.Decimal(15, 2)

  purchasedAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)

  buyer User @relation("PurchaseBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  seller User? @relation("PurchaseSeller", fields: [sellerId], references: [id], onDelete: SetNull)

  walletTransactions WalletTransaction[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([purchasedAt])
}
