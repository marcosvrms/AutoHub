// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AttributeType {
  BOOLEAN
  INTEGER
  DECIMAL
  TEXT
  SELECT
  MULTI_SELECT
}

model Category {
  id   String @id @default(uuid())
  name String @unique

  vehicleModels VehicleModel[]
  vehicleTypes  VehicleType[]
}

model VehicleType {
  id         String @id @default(uuid())
  categoryId String
  name       String

  category      Category       @relation(fields: [categoryId], references: [id])
  vehicleModels VehicleModel[]

  @@unique([categoryId, name])
}

model Manufacturer {
  id   String @id @default(uuid())
  name String @unique

  vehicleModels VehicleModel[]
}

model VehicleModel {
  id              String  @id @default(uuid())
  vehicleTypeId   String
  manufacturerId  String
  name            String
  manufactureYear Int
  description     String?
  catalogImage    String?

  vehicleType  VehicleType      @relation(fields: [vehicleTypeId], references: [id])
  manufacturer Manufacturer     @relation(fields: [manufacturerId], references: [id])
  attributes   ModelAttribute[]
  category     Category?        @relation(fields: [categoryId], references: [id])
  categoryId   String?

  @@unique([vehicleTypeId, manufacturerId, name, manufactureYear])
}

model ModelAttribute {
  id             String        @id @default(uuid())
  vehicleModelId String
  name           String
  type           AttributeType
  required       Boolean       @default(true)
  displayOrder   Int           @default(0)

  vehicleModel VehicleModel           @relation(fields: [vehicleModelId], references: [id], onDelete: Cascade)
  options      ModelAttributeOption[]

  @@unique([vehicleModelId, name])
}

model ModelAttributeOption {
  id           String @id @default(uuid())
  attributeId  String
  value        String
  displayOrder Int    @default(0)

  attribute ModelAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([attributeId, value])
}
